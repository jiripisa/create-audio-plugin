<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>{{APP}}</string>
    <key>CFBundleIdentifier</key>
    <string>{{BUNDLE_ID}}.audiounit</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>{{APP}}</string>
    <key>CFBundlePackageType</key>
    <string>BNDL</string>
    <!-- build.sh copies both version strings and the numeric AudioComponents
         version from the app's Info.plist; do not edit them here. -->
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- type / subtype / manufacturer are the plug-in's permanent identity
         (Sources/{{APP}}AU/include/{{APP}}AU.h). Hosts find saved
         projects by them: never change them. -->
    <key>AudioComponents</key>
    <array>
        <dict>
            <key>type</key>
            <string>aumu</string>
            <key>subtype</key>
            <string>{{AU_SUBTYPE}}</string>
            <key>manufacturer</key>
            <string>JPis</string>
            <key>name</key>
            <string>Jiri Pisa: {{APP}}</string>
            <key>description</key>
            <string>{{APP}}</string>
            <key>factoryFunction</key>
            <string>{{APP}}AUFactory</string>
            <key>version</key>
            <integer>0</integer>
            <key>sandboxSafe</key>
            <true/>
            <key>tags</key>
            <array>
                <string>Synthesizer</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
