 from datetime import date
 from pathlib import Path
 
 TEMPLATES = Path(__file__).resolve().parent.parent / "templates"
+BINARY_SUFFIXES = {".png", ".jpg", ".car", ".icns"}
+# Top-level entries of a --templates tree that are never rendered: SwiftPM's and
+# build.sh's output (an editor that indexes the tree as a package writes .build)
+# and the repository's own data.
+SKIPPED_TOP = {".build", "build", ".swiftpm", ".git"}
 FLAGS = ["PUBLIC", "WEBSITE", "MANUAL", "CS", "SPARKLE", "PLANNING", "LICENSE"]
 
